manifest {
  name = 'fixed-tree'
  author = 'Mathieu Fourment'
  homePage = 'https://github.com/4ment/fixed-tree-experiments'
  description = 'Constraining topology space: yea or nay'
  mainScript = 'main.nf'
}

profiles {
    docker {
        process.container = '4ment/fixed-tree-experiments'
        docker.enabled = true
    }
    conda {
        conda.enabled = true
        process {
            conda = "$NXF_CONDA_CACHEDIR/fixed-tree"
        }
    }
}
