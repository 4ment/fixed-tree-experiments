manifest {
  name = 'fixed-tree'
  author = 'Mathieu Fourment'
  homePage = 'https://github.com/4ment/fixed-tree-experiments'
  description = 'Constraining topology space: yea or nay'
  mainScript = 'main.nf'
}

process.conda = "$NXF_CONDA_CACHEDIR/fixed-tree"

profiles {
    pbspro {
        process{
            executor = 'pbspro'
            queue = 'workq'
            #scratch='/scratch/'
            clusterOptions = '-l select=1:ncpus=2:mem=10GB'
            time = '200h'
            withLabel: ultrafast{
                clusterOptions = '-l select=1:ncpus=2'
                time = '5m'
            }
        }
    }
    local {
        executor.cpus = 1
    }
}