# Read the data

temp <- readDiscreteCharacterData("ali-renamed.fasta")

data[1] <- temp
data[1].setCodonPartition( v(1,2) )
data[2] <- temp
data[2].setCodonPartition( 3 )


# Get some useful variables from the data. We need these later on.
num_taxa <- data[1].ntaxa()
num_branches <- 2 * num_taxa - 3
taxa <- data[1].taxa()
n_data_subsets <- data.size()

moves    = VectorMoves()
monitors = VectorMonitors()


######################
# Substitution Model #
######################

# specify the stationary frequency parameters
for (i in 1:n_data_subsets) {
    pi_prior[i] <- v(1,1,1,1) 
    pi[i] ~ dnDirichlet(pi_prior[i])
    moves.append( mvBetaSimplex(pi[i], weight=2) )
    moves.append( mvDirichletSimplex(pi[i], weight=1) )


    # specify the exchangeability rate parameters
    er_prior[i] <- v(1,1,1,1,1,1)
    er[i] ~ dnDirichlet(er_prior)
    moves.append( mvBetaSimplex(er[i], weight=3) )
    moves.append( mvDirichletSimplex(e[ir, weight=1) )


    # create a deterministic variable for the rate matrix, GTR
    Q[i] := fnGTR(er[i],pi[i]) 

    # Exponential with mean  0.5
    alpha[i] ~ dnExponential(2.0 )
    sr[i] := fnDiscretizeGamma( alpha[i], alpha[i], 4 )
    moves.append( mvScale(alpha[i], weight=2.0) )
}
##############
# Tree model #
##############

# Prior distribution on the tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight=num_taxa/2.0) )
moves.append( mvSPR(topology, weight=num_taxa/10.0) )

# Branch length prior
for (i in 1:num_branches) {
    bl[i] ~ dnExponential(10.0)
    moves.append( mvScale(bl[i]) )
}


TL := sum(bl)

psi := treeAssembly(topology, bl)




###################
# PhyloCTMC Model #
###################

for (i in 1:n_data_subsets) {
    # the sequence evolution model
    seq[i] ~ dnPhyloCTMC(tree=psi, Q=Q[i], siteRates=sr[i], type="DNA")

    # attach the data
    seq[i].clamp(data[i])
}


############
# Analysis #
############

mymodel = model(psi)

# add monitors
monitors.append( mnScreen(printgen=100, TL) )
monitors.append( mnFile(filename="revbayes.trees", printgen=10, psi) )
monitors.append( mnModel(filename="revbayes.log", printgen=10) )

# run the analysis
mymcmc = mcmc(mymodel, moves, monitors)
mymcmc.run(generations=200000)

# you may want to quit RevBayes now
q()



